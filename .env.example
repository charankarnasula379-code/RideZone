# Runtime
PORT=3001

# MySQL connection (fill these with your MySQL provider's private connection details)
DB_HOST=
DB_PORT=3306
DB_NAME=ridezone
DB_USER=
DB_PASSWORD=
# Keep false for local MySQL. Set true for hosted MySQL and provide its CA when required.
DB_SSL=false
DB_SSL_CA=
DB_CONNECTION_LIMIT=10

# Required: generate a unique secret, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=

# Optional: uncomment and replace all three to create the first admin at startup.
# Otherwise run `npm run create-admin` and follow the prompts.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
